{
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AzureAdWeb": {
    "TenantId": "local-development",
    "ClientId": "local-development",
    "ClientSecret": "local-development"
  },
  "AzureAdApi": {
    "TenantId": "local-development",
    "ClientId": "local-development",
    "Audience": "local-development"
  },
  "IdentityAssertion": {
    "Audience": "development-backend"
  },
  "ReverseProxy": {
    "Routes": {
      "development-service-a-route": {
        "ClusterId": "development-service-a-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/a/{**catch-all}"
        }
      },
      "development-service-b-route": {
        "ClusterId": "development-service-b-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/b/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "development-service-a-cluster": {
        "Destinations": {
          "service-a": {
            "Address": "http://localhost:5013/"
          }
        }
      },
      "development-service-b-cluster": {
        "Destinations": {
          "service-b": {
            "Address": "http://localhost:5014/"
          }
        }
      }
    }
  }
}
